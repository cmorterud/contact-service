# Documentation only; CDK does not automatically load this file.
# Real addresses belong in the AWS Secrets Manager JSON secret, never GitHub.
# JSON keys: senderEmail, recipientEmail, alertEmail.
# These three names describe the Lambda environment / direct CDK parameter mode.
SENDER_EMAIL=sender@example.com
RECIPIENT_EMAIL=recipient@example.com
ALERT_EMAIL=alerts@example.com

# Public deployment settings; export these locally or use GitHub environment variables.
AWS_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=123456789012
DEPLOY_ENV=prod
ALLOWED_ORIGINS=https://example.com,https://www.example.com
# AWS Secrets Manager version ID, copied after saving the private JSON in AWS.
CONFIG_VERSION=00000000-0000-0000-0000-000000000000
# Change only if CDK was bootstrapped with a custom qualifier.
CDK_QUALIFIER=hnb659fds

# Initial setup only. Check the repository's OIDC subject format (see README).
GITHUB_REPOSITORY=OWNER/REPOSITORY
GITHUB_OIDC_SUBJECT=repo:OWNER/REPOSITORY:environment:production
# Set true if this AWS account already has the GitHub OIDC provider.
EXISTING_GITHUB_OIDC_PROVIDER=false

# Optional public tuning; defaults shown. One API Gateway bucket shared by all
# callers/websites for POST /contact. Rate is tokens/second, burst is capacity.
# Default: 6 requests/minute sustained, burst 2 (one token refilled per 10 seconds).
# These are best-effort targets, not a guaranteed request ceiling or spending cap.
THROTTLE_RATE=0.1
THROTTLE_BURST=2
MONTHLY_BUDGET_USD=5
